<file path="tests/core/discount.test.ts">
import { describe, expect, it } from "vitest";
import type { DiscountRule } from "@/contracts";
import {
  bestDiscount,
  discountAmount,
  isDiscountEligible,
} from "@/core/discount";

function rule(overrides: Partial<DiscountRule> = {}): DiscountRule {
  return {
    id: "disc-1",
    name: "Test discount",
    type: "percent",
    value: 1000, // 10%
    scope: "products",
    productIds: ["prod-1"],
    minPurchase: 0,
    minQuantity: 1,
    startsAt: null,
    endsAt: null,
    usageLimit: null,
    perCustomerLimit: null,
    usedCount: 0,
    isActive: true,
    ...overrides,
  };
}

const ctx = {
  asOf: "2026-10-31",
  subtotal: 100_000,
  quantity: 2,
  customerRedemptions: {},
};

describe("discounts", () => {
  it("applies a percentage", () => {
    expect(discountAmount(rule(), 100_000)).toBe(10_000);
  });

  it("caps a fixed discount at the amount it applies to", () => {
    expect(discountAmount(rule({ type: "fixed", value: 50_000 }), 30_000)).toBe(30_000);
  });

  it("rejects a rule that has not started", () => {
    expect(isDiscountEligible(rule({ startsAt: "2026-11-01" }), ctx)).toBe(false);
  });

  it("rejects a rule that has expired", () => {
    expect(isDiscountEligible(rule({ endsAt: "2026-10-30" }), ctx)).toBe(false);
  });

  it("rejects a rule whose usage limit is reached", () => {
    expect(isDiscountEligible(rule({ usageLimit: 5, usedCount: 5 }), ctx)).toBe(false);
  });

  it("rejects a customer who used their allowance", () => {
    expect(
      isDiscountEligible(rule({ perCustomerLimit: 1 }), {
        ...ctx,
        customerRedemptions: { "disc-1": 1 },
      }),
    ).toBe(false);
  });

  it("rejects a basket below the minimum purchase", () => {
    expect(isDiscountEligible(rule({ minPurchase: 200_000 }), ctx)).toBe(false);
  });

  it("rejects a basket below the minimum quantity", () => {
    expect(isDiscountEligible(rule({ minQuantity: 3 }), ctx)).toBe(false);
  });

  it("rejects an inactive rule", () => {
    expect(isDiscountEligible(rule({ isActive: false }), ctx)).toBe(false);
  });

  it("keeps the bigger saving when two rules could apply", () => {
    const tenPercent = rule({ id: "ten", value: 1000 });
    const twentyPercent = rule({ id: "twenty", value: 2000 });
    const best = bestDiscount([tenPercent, twentyPercent], 100_000);
    expect(best?.discount.id).toBe("twenty");
    expect(best?.amount).toBe(20_000);
  });
});
</file>

<file path="tests/core/money.test.ts">
import { describe, expect, it } from "vitest";
import {
  allocateProRata,
  formatINR,
  paiseToRupees,
  roundHalfUp,
  rupeesToPaise,
} from "@/core/money";

describe("money", () => {
  it("converts rupees to paise without floating point drift", () => {
    expect(rupeesToPaise(999.99)).toBe(99999);
    expect(rupeesToPaise(0.1 + 0.2)).toBe(30);
  });

  it("converts paise back to rupees", () => {
    expect(paiseToRupees(184080)).toBe(1840.8);
  });

  it("formats with Indian digit grouping", () => {
    expect(formatINR(184080)).toBe("₹1,840.80");
    expect(formatINR(12345678)).toBe("₹1,23,456.78");
    expect(formatINR(5)).toBe("₹0.05");
  });

  it("rounds half up, not to even", () => {
    expect(roundHalfUp(2.5)).toBe(3);
    expect(roundHalfUp(2.4)).toBe(2);
    expect(roundHalfUp(28080)).toBe(28080);
  });

  it("splits an amount without losing a paise", () => {
    const parts = allocateProRata(100, [1, 1, 1]);
    expect(parts.reduce((a, b) => a + b, 0)).toBe(100);
    expect(parts).toEqual([34, 33, 33]);
  });

  it("splits proportionally to the weights", () => {
    expect(allocateProRata(1000, [3, 1])).toEqual([750, 250]);
  });

  it("returns zeros when there is nothing to split", () => {
    expect(allocateProRata(500, [0, 0])).toEqual([0, 0]);
  });
});
</file>

<file path="tests/core/periods.test.ts">
import { describe, expect, it } from "vitest";
import {
  addDays,
  addMonths,
  advance,
  daysBetween,
  isDue,
  periodEnd,
} from "@/core/periods";

describe("billing periods", () => {
  it("adds days across a month boundary", () => {
    expect(addDays("2026-01-31", 1)).toBe("2026-02-01");
  });

  it("advances a daily plan", () => {
    expect(advance("2026-03-01", "day")).toBe("2026-03-02");
  });

  it("advances a weekly plan by seven days", () => {
    expect(advance("2026-03-10", "week")).toBe("2026-03-17");
  });

  it("clamps to the end of a short month", () => {
    expect(advance("2026-01-31", "month", 1, 31)).toBe("2026-02-28");
  });

  it("restores the anchor day after a short month", () => {
    expect(advance("2026-02-28", "month", 1, 31)).toBe("2026-03-31");
  });

  it("handles a leap-day yearly plan", () => {
    expect(advance("2024-02-29", "year")).toBe("2025-02-28");
  });

  it("keeps the day of month for a normal monthly plan", () => {
    expect(addMonths("2026-06-15", 1)).toBe("2026-07-15");
  });

  it("counts the days between two dates", () => {
    expect(daysBetween("2026-01-01", "2026-01-31")).toBe(30);
  });

  it("treats a period end as exclusive", () => {
    const start = "2026-10-01";
    const end = periodEnd(start, "month");
    expect(end).toBe("2026-11-01");
    expect(daysBetween(start, end)).toBe(31);
  });

  it("is due on the billing date and when a run was missed", () => {
    expect(isDue("2026-10-31", "2026-10-31")).toBe(true);
    expect(isDue("2026-10-01", "2026-10-31")).toBe(true);
    expect(isDue("2026-11-01", "2026-10-31")).toBe(false);
  });
});
