<file path="tests/core/pricing.test.ts">
import { describe, expect, it } from "vitest";
import type {
  DiscountRule,
  ProductRef,
  TaxRule,
  VariantRef,
} from "@/contracts";
import { priceDocument } from "@/core/pricing";

const tax18: TaxRule = { id: "tax-18", name: "GST 18%", rateBp: 1800 };
const erp: ProductRef = {
  id: "prod-erp",
  name: "Brightloop ERP",
  salesPrice: 100_000, // ₹1,000
  taxId: "tax-18",
};
const odoo: VariantRef = {
  id: "var-odoo",
  attribute: "Brand",
  value: "Odoo",
  extraPrice: 56_000, // +₹560
};

function discount(overrides: Partial<DiscountRule> = {}): DiscountRule {
  return {
    id: "disc-1",
    name: "Test discount",
    type: "percent",
    value: 1000,
    scope: "products",
    productIds: ["prod-erp"],
    minPurchase: 0,
    minQuantity: 1,
    startsAt: null,
    endsAt: null,
    usageLimit: null,
    perCustomerLimit: null,
    usedCount: 0,
    isActive: true,
    ...overrides,
  };
}

const asOf = "2026-10-31";

describe("pricing", () => {
  it("adds the variant price to the product price", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [],
      asOf,
    });

    expect(doc.lines[0].unitPrice).toBe(156_000); // 1000 + 560
    expect(doc.lines[0].taxAmount).toBe(28_080); // 18% of 1560
    expect(doc.total).toBe(184_080);
  });

  it("multiplies by quantity", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 2 }],
      taxes: [tax18],
      discounts: [],
      asOf,
    });

    expect(doc.lines[0].gross).toBe(312_000);
    expect(doc.lines[0].taxAmount).toBe(56_160);
    expect(doc.total).toBe(368_160);
  });

  it("applies a product discount before tax", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [discount()],
      asOf,
    });

    expect(doc.discountTotal).toBe(15_600);
    expect(doc.lines[0].taxableAmount).toBe(140_400);
    expect(doc.lines[0].taxAmount).toBe(25_272);
    expect(doc.total).toBe(165_672);
  });

  it("caps a fixed discount at the line amount", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [discount({ type: "fixed", value: 500_000 })],
      asOf,
    });

    expect(doc.discountTotal).toBe(156_000);
    expect(doc.lines[0].taxableAmount).toBe(0);
    expect(doc.total).toBe(0);
  });

  it("spreads a subscription discount across the lines", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [discount({ scope: "subscription" })],
      asOf,
    });

    expect(doc.discountTotal).toBe(15_600);
    expect(doc.total).toBe(165_672);
  });

  it("keeps the bigger of two product discounts", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [discount({ id: "ten", value: 1000 }), discount({ id: "twenty", value: 2000 })],
      asOf,
    });

    expect(doc.discountTotal).toBe(31_200);
    expect(doc.appliedDiscounts).toEqual([{ discountId: "twenty", amount: 31_200 }]);
    expect(doc.total).toBe(147_264);
  });

  it("ignores an expired discount", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1 }],
      taxes: [tax18],
      discounts: [discount({ endsAt: "2026-10-01" })],
      asOf,
    });

    expect(doc.discountTotal).toBe(0);
    expect(doc.total).toBe(184_080);
  });

  it("charges no tax when the product has no tax rule", () => {
    const doc = priceDocument({
      lines: [{ product: { ...erp, taxId: null }, quantity: 1 }],
      taxes: [tax18],
      discounts: [],
      asOf,
    });

    expect(doc.lines[0].taxAmount).toBe(0);
    expect(doc.total).toBe(100_000);
  });

  it("uses a negotiated unit price instead of the catalogue price", () => {
    const doc = priceDocument({
      lines: [{ product: erp, variant: odoo, quantity: 1, unitPriceOverride: 200_000 }],
      taxes: [tax18],
      discounts: [],
      asOf,
    });

    expect(doc.lines[0].unitPrice).toBe(200_000);
    expect(doc.total).toBe(236_000);
  });

  it("adds up several lines", () => {
    const addon: ProductRef = { id: "prod-addon", name: "Backup add-on", salesPrice: 20_000, taxId: "tax-18" };
    const doc = priceDocument({
      lines: [
        { product: erp, variant: odoo, quantity: 1 },
        { product: addon, quantity: 2 },
      ],
      taxes: [tax18],
      discounts: [],
      asOf,
    });

    expect(doc.subtotal).toBe(196_000);
    expect(doc.total).toBe(231_280); // (1560 + 400) × 1.18
  });
});
</file>

<file path="tests/core/state.test.ts">
import { describe, expect, it } from "vitest";
import type { PlanPolicy } from "@/contracts";
import {
  checkTransition,
  deriveInvoiceStatus,
  invoiceBalance,
  nextSubStatus,
} from "@/core/state";

const openPlan: PlanPolicy = {
  pausable: true,
  renewable: true,
  closable: true,
  autoClose: false,
};

describe("subscription status", () => {
  it("moves draft to quotation to confirmed to active", () => {
    expect(nextSubStatus("draft", "send_quote")).toBe("quotation");
    expect(nextSubStatus("quotation", "confirm")).toBe("confirmed");
    expect(nextSubStatus("confirmed", "activate")).toBe("active");
  });

  it("rejects a move that is not in the table", () => {
    expect(nextSubStatus("active", "confirm")).toBeNull();
    expect(nextSubStatus("closed", "activate")).toBeNull();
  });

  it("honours the plan switches", () => {
    const noPause: PlanPolicy = { ...openPlan, pausable: false };
    expect(checkTransition({ from: "active", event: "pause", plan: noPause }).ok).toBe(false);
    expect(checkTransition({ from: "active", event: "pause", plan: openPlan }).ok).toBe(true);
  });

  it("explains why a move was refused", () => {
    const locked: PlanPolicy = { ...openPlan, closable: false, autoClose: false };
    const result = checkTransition({ from: "active", event: "close", plan: locked });
    expect(result.ok).toBe(false);
    expect(result.reason).toContain("closed early");
  });
});

describe("invoice status", () => {
  const base = { total: 100_000, dueDate: "2026-10-31", today: "2026-11-05" };

  it("is draft until it is confirmed", () => {
    expect(deriveInvoiceStatus({ ...base, amountPaid: 0 })).toBe("draft");
  });

  it("is overdue when confirmed, unpaid and past the due date", () => {
    expect(deriveInvoiceStatus({ ...base, amountPaid: 0, confirmed: true })).toBe("overdue");
  });

  it("is confirmed when still inside the payment terms", () => {
    expect(
      deriveInvoiceStatus({ ...base, amountPaid: 0, confirmed: true, today: "2026-10-30" }),
    ).toBe("confirmed");
  });

  it("is partially paid between zero and the total", () => {
    expect(deriveInvoiceStatus({ ...base, amountPaid: 40_000, confirmed: true })).toBe(
      "partially_paid",
    );
  });

  it("is paid once the total is covered", () => {
    expect(deriveInvoiceStatus({ ...base, amountPaid: 100_000, confirmed: true })).toBe("paid");
  });

  it("never shows a negative balance", () => {
    expect(invoiceBalance(100_000, 120_000)).toBe(0);
    expect(invoiceBalance(100_000, 40_000)).toBe(60_000);
  });
});
