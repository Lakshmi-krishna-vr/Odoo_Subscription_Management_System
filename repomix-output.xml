<file path="src/core/discount.ts">
import type { DiscountRule, Paise } from "@/contracts";
import { roundHalfUp } from "./money";

export interface EligibilityContext {
  /** ISO date the eligibility is judged on */
  asOf: string;
  /** the amount the rule is judged against (line gross, or document subtotal) */
  subtotal: Paise;
  /** quantity the rule is judged against */
  quantity: number;
  /** redemptions already used by this customer, keyed by discount id */
  customerRedemptions: Readonly<Record<string, number>>;
}

/**
 * Every condition the brief lists must pass:
 * active, inside the date window, under the usage limits, above the minimum
 * purchase and quantity.
 */
export function isDiscountEligible(
  rule: DiscountRule,
  ctx: EligibilityContext,
): boolean {
  if (!rule.isActive) return false;
  if (rule.startsAt !== null && ctx.asOf < rule.startsAt) return false;
  if (rule.endsAt !== null && ctx.asOf > rule.endsAt) return false;
  if (rule.usageLimit !== null && rule.usedCount >= rule.usageLimit) return false;

  const usedByCustomer = ctx.customerRedemptions[rule.id] ?? 0;
  if (rule.perCustomerLimit !== null && usedByCustomer >= rule.perCustomerLimit) {
    return false;
  }

  if (ctx.subtotal < rule.minPurchase) return false;
  if (ctx.quantity < rule.minQuantity) return false;

  return true;
}

/** The saving a rule gives on `base`, never more than the base itself. */
export function discountAmount(rule: DiscountRule, base: Paise): Paise {
  if (base <= 0) return 0;
  const raw =
    rule.type === "fixed" ? rule.value : roundHalfUp((base * rule.value) / 10_000);
  return Math.min(raw, base);
}

export interface AppliedDiscount {
  discount: DiscountRule;
  amount: Paise;
}

/**
 * At most one discount per level, and the customer gets the bigger saving.
 * Stacking two percentage rules is how invoices end up negative.
 */
export function bestDiscount(
  candidates: readonly DiscountRule[],
  base: Paise,
): AppliedDiscount | null {
  let best: AppliedDiscount | null = null;
  for (const discount of candidates) {
    const amount = discountAmount(discount, base);
    if (amount <= 0) continue;
    if (best === null || amount > best.amount) best = { discount, amount };
  }
  return best;
}
</file>

<file path="src/core/money.ts">
import type { Paise } from "@/contracts";

/** ₹ → paise, rounded to the nearest paise. */
export function rupeesToPaise(rupees: number): Paise {
  return Math.round(rupees * 100);
}

export function paiseToRupees(paise: Paise): number {
  return paise / 100;
}

/** Round half up. Banker's rounding is wrong for invoicing. */
export function roundHalfUp(value: number): number {
  return Math.floor(value + 0.5);
}

/** ₹1,23,456.78 — Indian digit grouping (last three, then pairs). */
export function formatINR(paise: Paise): string {
  const negative = paise < 0;
  const abs = Math.abs(Math.round(paise));
  const rupees = Math.floor(abs / 100).toString();
  const fraction = (abs % 100).toString().padStart(2, "0");

  const lastThree = rupees.slice(-3);
  const rest = rupees.slice(0, -3);
  const grouped = rest
    ? `${rest.replace(/\B(?=(\d{2})+(?!\d))/g, ",")},${lastThree}`
    : lastThree;

  return `${negative ? "-" : ""}₹${grouped}.${fraction}`;
}

/**
 * Split `total` across `weights` so that the parts add up to exactly `total`.
 * Rounding leftovers go to the largest fractional parts.
 */
export function allocateProRata(total: Paise, weights: readonly number[]): Paise[] {
  const sum = weights.reduce((a, b) => a + b, 0);
  if (sum <= 0 || weights.length === 0) return weights.map(() => 0);

  const exact = weights.map((w) => (total * w) / sum);
  const floors = exact.map((x) => Math.floor(x));
  let remainder = total - floors.reduce((a, b) => a + b, 0);

  const order = exact
    .map((x, i) => ({ i, frac: x - Math.floor(x) }))
    .sort((a, b) => b.frac - a.frac);

  const out = [...floors];
  for (const { i } of order) {
    if (remainder <= 0) break;
    out[i] += 1;
    remainder -= 1;
  }
  return out;
}
</file>

<file path="src/core/pricing.ts">
import type {
  DiscountRule,
  Paise,
  PriceInput,
  PricedDoc,
  PricedLine,
} from "@/contracts";
import { allocateProRata, roundHalfUp } from "./money";
import { bestDiscount, isDiscountEligible, type AppliedDiscount } from "./discount";

/**
 * The one pricing function. Quotes, billing previews and invoices all call it,
 * so the customer sees the same number everywhere.
 *
 * Order of operations:
 *   unit price  = catalogue price + variant extra (or a negotiated override)
 *   gross       = unit price × quantity
 *   line disc.  = best product-scope discount, capped at the gross
 *   order disc.  = best subscription-scope discount, spread across the lines
 *   tax         = on what is left, per line, rounded half up
 */
export function priceDocument(input: PriceInput): PricedDoc {
  const warnings: string[] = [];
  const redemptions = input.customerRedemptions ?? {};

  const base = input.lines.map((line) => {
    const unitPrice =
      line.unitPriceOverride ?? line.product.salesPrice + (line.variant?.extraPrice ?? 0);
    return {
      line,
      unitPrice,
      gross: unitPrice * line.quantity,
      discount: null as AppliedDiscount | null,
    };
  });

  // product-scope discounts are judged on the line they apply to
  for (const row of base) {
    const candidates = input.discounts.filter(
      (rule) =>
        rule.scope === "products" &&
        rule.productIds.includes(row.line.product.id) &&
        isDiscountEligible(rule, {
          asOf: input.asOf,
          subtotal: row.gross,
          quantity: row.line.quantity,
          customerRedemptions: redemptions,
        }),
    );
    row.discount = bestDiscount(candidates, row.gross);
  }

  const afterLineDiscounts = base.reduce(
    (sum, row) => sum + row.gross - (row.discount?.amount ?? 0),
    0,
  );
  const totalQuantity = base.reduce((sum, row) => sum + row.line.quantity, 0);

  const orderCandidates: DiscountRule[] = input.discounts.filter(
    (rule) =>
      rule.scope === "subscription" &&
      isDiscountEligible(rule, {
        asOf: input.asOf,
        subtotal: afterLineDiscounts,
        quantity: totalQuantity,
        customerRedemptions: redemptions,
      }),
  );
  const orderDiscount = bestDiscount(orderCandidates, afterLineDiscounts);
  const orderAllocation = orderDiscount
    ? allocateProRata(
        orderDiscount.amount,
        base.map((row) => row.gross - (row.discount?.amount ?? 0)),
      )
    : base.map(() => 0);

  const taxById = new Map(input.taxes.map((tax) => [tax.id, tax]));
  const applied = new Map<string, Paise>();

  const lines: PricedLine[] = base.map((row, index) => {
    const lineDiscount = row.discount?.amount ?? 0;
    const allocated = orderAllocation[index];
    const taxableAmount = Math.max(0, row.gross - lineDiscount - allocated);

    const taxRule = row.line.product.taxId
      ? taxById.get(row.line.product.taxId)
      : undefined;
    const taxRateBp = taxRule?.rateBp ?? 0;
    if (row.line.product.taxId && !taxRule) {
      warnings.push(`unknown tax ${row.line.product.taxId} on ${row.line.product.name}`);
    }
    const taxAmount = roundHalfUp((taxableAmount * taxRateBp) / 10_000);

    if (row.discount) {
      applied.set(
        row.discount.discount.id,
        (applied.get(row.discount.discount.id) ?? 0) + lineDiscount,
      );
    }
    if (orderDiscount) {
      applied.set(
        orderDiscount.discount.id,
        (applied.get(orderDiscount.discount.id) ?? 0) + allocated,
      );
    }

    const discountIds: string[] = [];
    if (row.discount) discountIds.push(row.discount.discount.id);
    if (orderDiscount) discountIds.push(orderDiscount.discount.id);

    return {
      productId: row.line.product.id,
      description: row.line.variant
        ? `${row.line.product.name} (${row.line.variant.attribute}: ${row.line.variant.value})`
        : row.line.product.name,
      quantity: row.line.quantity,
      unitPrice: row.unitPrice,
      gross: row.gross,
      discountAmount: lineDiscount + allocated,
      appliedDiscountIds: discountIds,
      taxableAmount,
      taxRateBp,
      taxAmount,
      lineTotal: taxableAmount + taxAmount,
    };
  });

  const subtotal = base.reduce((sum, row) => sum + row.gross, 0);
  const discountTotal = lines.reduce((sum, line) => sum + line.discountAmount, 0);
  const taxTotal = lines.reduce((sum, line) => sum + line.taxAmount, 0);
  const total = lines.reduce((sum, line) => sum + line.lineTotal, 0);

  return {
    lines,
    subtotal,
    discountTotal,
    taxTotal,
    total,
    appliedDiscounts: [...applied.entries()].map(([discountId, amount]) => ({
      discountId,
      amount,
    })),
    warnings,
  };
}
</file>

<file path="src/core/state.ts">
import type {
  InvoiceStatus,
  Paise,
  PlanPolicy,
  SubEvent,
  SubStatus,
} from "@/contracts";

/** Every allowed move. Anything not listed here is rejected. */
export const SUB_TRANSITIONS: Readonly<
  Record<SubEvent, { from: readonly SubStatus[]; to: SubStatus }>
> = {
  send_quote: { from: ["draft"], to: "quotation" },
  confirm: { from: ["quotation"], to: "confirmed" },
  activate: { from: ["confirmed"], to: "active" },
  pause: { from: ["active"], to: "paused" },
  resume: { from: ["paused"], to: "active" },
  renew: { from: ["active"], to: "active" },
  close: { from: ["active", "paused", "confirmed"], to: "closed" },
};

export function nextSubStatus(from: SubStatus, event: SubEvent): SubStatus | null {
  const transition = SUB_TRANSITIONS[event];
  return transition.from.includes(from) ? transition.to : null;
}

export interface TransitionCheck {
  ok: boolean;
  next?: SubStatus;
  reason?: string;
}

/**
 * Checks the transition table first, then the plan's switches — the admin
 * decides per plan whether a subscription can be closed early, paused or renewed.
 */
export function checkTransition(args: {
  from: SubStatus;
  event: SubEvent;
  plan: PlanPolicy;
}): TransitionCheck {
  const next = nextSubStatus(args.from, args.event);
  if (next === null) {
    return {
      ok: false,
      reason: `cannot ${args.event} a subscription that is ${args.from}`,
    };
  }

  if (args.event === "pause" && !args.plan.pausable) {
    return { ok: false, reason: "this plan cannot be paused" };
  }
  if (args.event === "renew" && !args.plan.renewable) {
    return { ok: false, reason: "this plan cannot be renewed" };
  }
  if (args.event === "close" && !args.plan.closable && !args.plan.autoClose) {
    return { ok: false, reason: "this plan cannot be closed early" };
  }

  return { ok: true, next };
}

export function invoiceBalance(total: Paise, amountPaid: Paise): Paise {
  return Math.max(0, total - amountPaid);
}

/**
 * Invoice status is derived from the money, never set by hand.
 * `overdue` depends on today's date, so it stays correct without a cron job.
 */
export function deriveInvoiceStatus(args: {
  total: Paise;
  amountPaid: Paise;
  dueDate: string;
  today: string;
  cancelled?: boolean;
  confirmed?: boolean;
}): InvoiceStatus {
  if (args.cancelled) return "cancelled";
  if (!args.confirmed) return "draft";
  if (args.amountPaid >= args.total) return "paid";
  if (args.amountPaid > 0) return "partially_paid";
  return args.dueDate < args.today ? "overdue" : "confirmed";
}
