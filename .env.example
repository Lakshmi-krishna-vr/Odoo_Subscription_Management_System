# Postgres connection string (Neon / Supabase / any Postgres 14+)
DATABASE_URL="postgresql://user:password@host:5432/subscriptions?sslmode=require"

# Secret used to sign session cookies
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: SMTP for password-reset email. If unset, reset links are written to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""

# Header secret for /api/jobs/* (scheduler or n8n)
JOB_SECRET="change-me"
